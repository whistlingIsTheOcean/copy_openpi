{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Train (debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train.py",
            "args": [
                "debug",
                "--exp-name",
                "my_debug",
                "--overwrite"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/lerobot/src"
            },
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}